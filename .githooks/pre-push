#!/bin/sh
# Runs the PR CI checks (ruff + the full test suite, .github/workflows/ci.yml) before every push, so a push
# never turns the pipeline red. Enable once per clone:  git config core.hooksPath .githooks
# Skip once (e.g. a docs-only push):                     git push --no-verify
set -e

# Nothing to check when the push only deletes refs (the local sha is all zeros).
pushes=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        *[!0]*) pushes=1 ;;
    esac
done
[ "$pushes" -eq 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)"
echo "pre-push: ruff check ..."
uv run ruff check .
echo "pre-push: pytest ..."
QT_QPA_PLATFORM=offscreen uv run pytest -q
